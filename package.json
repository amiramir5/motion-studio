{
  "name": "motion-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Turn HTML/CSS/JS motion graphics into frame-accurate MP4 films.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/styles.css --bundle --minify --external:./fonts/* --outfile=docs/styles.css --log-level=warning && esbuild src/app.js --bundle --minify --format=iife --target=es2020 --outfile=docs/app.js --log-level=warning",
    "start": "npm run build && node server/index.js",
    "dev": "npm run build && node --watch server/index.js",
    "render:test": "node scripts/render-test.js",
    "icons": "node scripts/make-icons.js",
    "ai:test": "node scripts/ai-test.js"
  },
  "keywords": [
    "motion-graphics",
    "mp4",
    "html",
    "renderer"
  ],
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
