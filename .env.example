# Copy this file to .env and add your key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Leave empty to auto-pick the fastest available Flash model.
GEMINI_MODEL=

# 0 = disable thinking for speed (default), auto = let the model decide.
GEMINI_THINKING=0

PORT=4173

# Optional: point to a specific Chrome/Edge executable.
CHROME_PATH=
